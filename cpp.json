    "BFS": {
        "prefix": "bfs",
        "body": [
            "void bfs(int src,vector<vi>& adj,vi& vis){",
            "    queue<int> q;",
            "    q.push(src);",
            "    vis[src]=1;",
            "    while(!q.empty()){",
            "        int u=q.front();",
            "        q.pop();",
            "        for(int v:adj[u]){",
            "            if(!vis[v]){",
            "                vis[v]=1;",
            "                q.push(v);",
            "            }",
            "        }",
            "    }",
            "}"
        ],
        "description": "Breadth-first traversal; requires vi"
    },

    "DFS": {
        "prefix": "dfs",
        "body": [
            "void dfs(int u,vector<vi>& adj,vi& vis){",
            "    vis[u]=1;",
            "    for(int v:adj[u]){",
            "        if(!vis[v])dfs(v,adj,vis);",
            "    }",
            "}"
        ],
        "description": "Depth-first traversal; requires vi"
    },

    "DSU": {
        "prefix": "dsu",
        "body": [
            "struct DSU{",
            "    vi par,sz;",
            "    DSU(int n){",
            "        par.resize(n+1);",
            "        sz.assign(n+1,1);",
            "        iota(par.begin(),par.end(),0);",
            "    }",
            "    int find(int x){",
            "        if(par[x]==x)return x;",
            "        return par[x]=find(par[x]);",
            "    }",
            "    bool unite(int a,int b){",
            "        a=find(a);",
            "        b=find(b);",
            "        if(a==b)return false;",
            "        if(sz[a]<sz[b])swap(a,b);",
            "        par[b]=a;",
            "        sz[a]+=sz[b];",
            "        return true;",
            "    }",
            "};"
        ],
        "description": "DSU with path compression and union by size; requires vi"
    },

