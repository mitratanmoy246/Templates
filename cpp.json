    "Dijkstra": {
        "prefix": "dijkstra",
        "body": [
            "vector<ll> dijkstra(int src,vector<vector<pair<int,int>>>& adj){",
            "    int n=adj.size();",
            "    vector<ll> dist(n,INF);",
            "    priority_queue<pair<ll,int>,vector<pair<ll,int>>,greater<pair<ll,int>>> pq;",
            "    dist[src]=0;",
            "    pq.push({0,src});",
            "    while(!pq.empty()){",
            "        auto [d,u]=pq.top();",
            "        pq.pop();",
            "        if(d!=dist[u])continue;",
            "        for(auto [v,w]:adj[u]){",
            "            if(dist[v]>d+w){",
            "                dist[v]=d+w;",
            "                pq.push({dist[v],v});",
            "            }",
            "        }",
            "    }",
            "    return dist;",
            "}"
        ],
        "description": "Shortest paths for non-negative edge weights; requires ll and INF"
    },

