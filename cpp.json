
{
    "Competitive Programming Template": {
        "prefix": "cp",
        "body": [
            "#include <bits/stdc++.h>",
            "using namespace std;",
            "",
            "using ll = long long;",
            "using ull = unsigned long long;",
            "using ld = long double;",
            "using vi = vector<int>;",
            "using vll = vector<ll>;",
            "",
            "constexpr int MOD = 1000000007;",
            "constexpr ll INF = 1000000000000000000LL;",
            "",
            "#define fast ios::sync_with_stdio(false); cin.tie(nullptr)",
            "#define pb push_back",
            "#define F first",
            "#define S second",
            "#define all(v) (v).begin(), (v).end()",
            "#define rall(v) (v).rbegin(), (v).rend()",
            "#define sz(v) ((int)(v).size())",
            "",
            "#define read(a,n) for(int i=0;i<n;i++) cin>>a[i]",
            "#define print(v) for(auto x:v) cout<<x<<' '; cout<<'\\n'",
            "#define yes cout<<\"YES\\n\"",
            "#define no cout<<\"NO\\n\"",
            "#define endl '\\n'",
            "",
            "void solve(){",
            "    int n;",
            "    cin>>n;",
            "    vi a(n);",
            "    read(a,n);",
            "    $0",
            "}",
            "",
            "signed main(){",
            "    fast;",
            "",
            "    int test_case=1;",
            "    // cin>>test_case;",
            "",
            "    while(test_case--){",
            "        solve();",
            "    }",
            "",
            "    return 0;",
            "}"
        ],
        "description": "Minimal competitive programming template"
    },

    "GCD Function": {
        "prefix": "gcd",
        "body": [
            "ll gcdll(ll a,ll b){",
            "    while(b){",
            "        ll r=a%b;",
            "        a=b;",
            "        b=r;",
            "    }",
            "    return a<0?-a:a;",
            "}"
        ],
        "description": "GCD; requires ll"
    },

    "LCM Function": {
        "prefix": "lcm",
        "body": [
            "ll lcmll(ll a,ll b){",
            "    if(a==0 || b==0)return 0;",
            "    return a/gcdll(a,b)*b;",
            "}"
        ],
        "description": "LCM; requires ll and gcdll"
    },

    "Binary Exponentiation": {
        "prefix": "binpow",
        "body": [
            "ll binpow(ll a,ll b){",
            "    ll res=1;",
            "    while(b>0){",
            "        if(b&1)res*=a;",
            "        b>>=1;",
            "        if(b)a*=a;",
            "    }",
            "    return res;",
            "}"
        ],
        "description": "Ordinary binary exponentiation; may overflow"
    },

    "Modular Exponentiation": {
        "prefix": "modpow",
        "body": [
            "ll modpow(ll a,ll b,ll mod=MOD){",
            "    ll res=1;",
            "    a%=mod;",
            "    while(b>0){",
            "        if(b&1)res=res*a%mod;",
            "        a=a*a%mod;",
            "        b>>=1;",
            "    }",
            "    return res;",
            "}"
        ],
        "description": "Modular exponentiation; requires ll and MOD"
    },

    "Modular Inverse": {
        "prefix": "modinv",
        "body": [
            "ll modInverse(ll n,ll mod=MOD){",
            "    return modpow(n,mod-2,mod);",
            "}"
        ],
        "description": "Requires modpow; prime modulus and n not divisible by mod"
    },

    "Prime Check": {
        "prefix": "isprime",
        "body": [
            "bool isPrime(ll n){",
            "    if(n<2)return false;",
            "    if(n<=3)return true;",
            "    if(n%2==0 || n%3==0)return false;",
            "    for(ll i=5;i<=n/i;i+=6){",
            "        if(n%i==0 || n%(i+2)==0)return false;",
            "    }",
            "    return true;",
            "}"
        ],
        "description": "Primality test; requires ll"
    },

    "Sieve of Eratosthenes": {
        "prefix": "sieve",
        "body": [
            "vi sieve(int n){",
            "    vi prime(n+1,1);",
            "    prime[0]=0;",
            "    if(n>=1)prime[1]=0;",
            "    for(ll i=2;i*i<=n;i++){",
            "        if(prime[i]){",
            "            for(ll j=i*i;j<=n;j+=i){",
            "                prime[j]=0;",
            "            }",
            "        }",
            "    }",
            "    return prime;",
            "}"
        ],
        "description": "Prime marking sieve; requires vi and ll"
    },

    "SPF Sieve": {
        "prefix": "spf",
        "body": [
            "vi spf,primes;",
            "",
            "void buildSPF(int n){",
            "    spf.assign(n+1,0);",
            "    primes.clear();",
            "    for(int i=2;i<=n;i++)spf[i]=i;",
            "    for(ll i=2;i*i<=n;i++){",
            "        if(spf[i]==i){",
            "            for(ll j=i*i;j<=n;j+=i){",
            "                if(spf[j]==j)spf[j]=i;",
            "            }",
            "        }",
            "    }",
            "    for(int i=2;i<=n;i++){",
            "        if(spf[i]==i)primes.pb(i);",
            "    }",
            "}"
        ],
        "description": "Smallest prime factor sieve; requires vi, ll and pb"
    },

    "Prime Factorization": {
        "prefix": "factor",
        "body": [
            "vi getFactorization(int x){",
            "    vi ret;",
            "    if(x<1 || x>=sz(spf))return ret;",
            "    while(x>1){",
            "        ret.pb(spf[x]);",
            "        x/=spf[x];",
            "    }",
            "    return ret;",
            "}"
        ],
        "description": "Requires SPF sieve, vi, sz and pb"
    },

    "Factorization with Powers": {
        "prefix": "factorpow",
        "body": [
            "vector<pair<int,int>> getFactorizationPowers(int x){",
            "    vector<pair<int,int>> ret;",
            "    if(x<1 || x>=sz(spf))return ret;",
            "    while(x>1){",
            "        int p=spf[x],cnt=0;",
            "        while(x%p==0){",
            "            cnt++;",
            "            x/=p;",
            "        }",
            "        ret.emplace_back(p,cnt);",
            "    }",
            "    return ret;",
            "}"
        ],
        "description": "Prime factors with exponents; requires SPF sieve and sz"
    },

    "Get Divisors": {
        "prefix": "divisors",
        "body": [
            "vi getDivisors(int n){",
            "    vi divs;",
            "    if(n<=0)return divs;",
            "    for(ll i=1;i*i<=n;i++){",
            "        if(n%i==0){",
            "            divs.pb(i);",
            "            if(i*i!=n)divs.pb(n/i);",
            "        }",
            "    }",
            "    sort(all(divs));",
            "    return divs;",
            "}"
        ],
        "description": "Returns all positive divisors in sorted order"
    },

    "Count Divisors": {
        "prefix": "cntdiv",
        "body": [
            "int countDivisors(int n){",
            "    if(n<=0)return 0;",
            "    int cnt=0;",
            "    for(ll i=1;i*i<=n;i++){",
            "        if(n%i==0){",
            "            cnt++;",
            "            if(i*i!=n)cnt++;",
            "        }",
            "    }",
            "    return cnt;",
            "}"
        ],
        "description": "Counts positive divisors"
    },

    "Sum Divisors": {
        "prefix": "sumdiv",
        "body": [
            "ll sumDivisors(int n){",
            "    if(n<=0)return 0;",
            "    ll sum=0;",
            "    for(ll i=1;i*i<=n;i++){",
            "        if(n%i==0){",
            "            sum+=i;",
            "            if(i*i!=n)sum+=n/i;",
            "        }",
            "    }",
            "    return sum;",
            "}"
        ],
        "description": "Sum of all positive divisors"
    },

    "Euler Totient": {
        "prefix": "phi",
        "body": [
            "int phi(int n){",
            "    if(n<=0)return 0;",
            "    int res=n;",
            "    for(ll i=2;i*i<=n;i++){",
            "        if(n%i==0){",
            "            while(n%i==0)n/=i;",
            "            res-=res/(int)i;",
            "        }",
            "    }",
            "    if(n>1)res-=res/n;",
            "    return res;",
            "}"
        ],
        "description": "Euler totient function; requires ll"
    },

